# MindSync AI - Frontend Environment Variables
# ============================================
# For Azure Container Apps deployment, these are set via:
# - Container App environment variables
# - Key Vault secrets (for sensitive values)
# - Bicep deployment outputs (for service URLs)

# API URL (set at build time via REACT_APP_API_URL)
# In Azure: injected via Container App env var from Key Vault
REACT_APP_API_URL=https://<backend-fqdn>

# For local development only:
# REACT_APP_API_URL=http://localhost:8000