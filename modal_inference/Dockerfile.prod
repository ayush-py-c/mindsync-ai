# MindSync AI Inference - Production (CPU)
# Multi-stage: build ML deps -> runtime

# ---- Build Stage ----
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev \
    ffmpeg libsndfile1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# CPU PyTorch
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.2.2 torchvision==0.17.2

COPY modal_inference/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir "fer==22.5.1" --no-deps


# ---- Runtime Stage ----
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

ENV TF_USE_LEGACY_KERAS=1 \
    TF_CPP_MIN_LOG_LEVEL=3 \
    PYTHONUNBUFFERED=1

# Copy app code
COPY modal_inference/config.py ./config.py
COPY modal_inference/auth.py ./auth.py
COPY modal_inference/schemas.py ./schemas.py
COPY modal_inference/service.py ./service.py
COPY modal_inference/cache.py ./cache.py
COPY modal_inference/rate_limit.py ./rate_limit.py
COPY modal_inference/metrics.py ./metrics.py
COPY modal_inference/metrics_store.py ./metrics_store.py
COPY modal_inference/download_models.py ./download_models.py
COPY modal_inference/inference ./inference
COPY modal_inference/recommendation ./recommendation

# Bundled assets
COPY modal_inference/assets ./assets

# Entrypoint
COPY modal_inference/entrypoint.prod.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Models dir
RUN mkdir -p /models/text_emotion_model && \
    groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin appuser && \
    chown -R appuser:appgroup /app /models

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=3 \
    CMD wget -q --spider http://localhost:8001/health || exit 1

ENTRYPOINT ["./entrypoint.sh"]