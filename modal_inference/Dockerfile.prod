# MindSync AI Inference - Production (CPU)
# Multi-stage: build ML deps -> runtime

# ---- Build Stage ----
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev \
    ffmpeg libsndfile1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# CPU PyTorch
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.2.2 torchvision==0.17.2

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir "fer==22.5.1" --no-deps


# ---- Runtime Stage ----
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libgl1 libglib2.0-0 curl wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

ENV TF_USE_LEGACY_KERAS=1 \
    TF_CPP_MIN_LOG_LEVEL=3 \
    PYTHONUNBUFFERED=1

# Copy app code
COPY config.py ./config.py
COPY auth.py ./auth.py
COPY schemas.py ./schemas.py
COPY service.py ./service.py
COPY cache.py ./cache.py
COPY rate_limit.py ./rate_limit.py
COPY metrics.py ./metrics.py
COPY metrics_store.py ./metrics_store.py
COPY download_models.py ./download_models.py
COPY inference ./inference
COPY recommendation ./recommendation

# Bundled assets
COPY assets ./assets

# Entrypoint
COPY entrypoint.prod.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Models dir
RUN mkdir -p /models/text_emotion_model && \
    groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin appuser && \
    chown -R appuser:appgroup /app /models

USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8001/health || exit 1

ENTRYPOINT ["./entrypoint.sh"]